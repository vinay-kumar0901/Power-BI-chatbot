		dataType: string
		lineageTag: d6f5bbcc-363d-48b3-82d6-1cce1f73390c
		summarizeBy: none
		sourceColumn: CustomerName

		annotation SummarizationSetBy = Automatic

	column Gender
		dataType: string
		lineageTag: 715e108d-3987-4bd7-81cd-4804a5b22861
