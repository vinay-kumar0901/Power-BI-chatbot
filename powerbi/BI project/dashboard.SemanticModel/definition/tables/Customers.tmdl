		sourceColumn: Gender

		annotation SummarizationSetBy = Automatic

	column Age
		dataType: int64
		formatString: 0
		lineageTag: 8b9d22bb-4499-4a15-82bc-43dc985514bd
		summarizeBy: sum
		sourceColumn: Age

		annotation SummarizationSetBy = Automatic

	column City
		dataType: string
		lineageTag: 1c1656e7-f8e9-4e50-9a6f-7ffb8242e17b
		summarizeBy: none
		sourceColumn: City

		annotation SummarizationSetBy = Automatic

	column State
		dataType: string
		lineageTag: 2d6c0ef3-6f42-4ab6-b619-12bef46f890a
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = Automatic

	column CustomerSegment
		dataType: string
		lineageTag: 9ef25c9f-cf1d-4cfe-b52a-eb5f805de3d0
		summarizeBy: none
		sourceColumn: CustomerSegment

		annotation SummarizationSetBy = Automatic

	column JoinDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: 9b9cd321-12e0-4c13-bc34-d6c144e198f5
		summarizeBy: none
		sourceColumn: JoinDate

		variation Variation
			isDefault
			relationship: be4f6d25-19af-4203-9ba8-23fd7259a5fc
			defaultHierarchy: LocalDateTable_9ed8988b-37f4-49d2-ac90-9b12f5ca7a41.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition Customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/vinay-kumar0901/Power-BI-chatbot/main/Dataset/Customers.csv"),[Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"CustomerID", Int64.Type}, {"CustomerName", type text}, {"Gender", type text}, {"Age", Int64.Type}, {"City", type text}, {"State", type text}, {"CustomerSegment", type text}, {"JoinDate", type date}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

